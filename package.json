{
  "name": "slicer-cc",
  "productName": "Slicer CC",
  "version": "0.2.0",
  "description": "Simple slicer for Elegoo Centauri Carbon: three choices for beginners and a reliable send to the printer",
  "author": "ALEXalesha",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "homepage": "https://github.com/ALEXalesha/Slicer",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 \"tests/core/*.test.js\"",
    "test:app": "playwright test --config=playwright.app.config.js --workers=1",
    "mutate": "node tools/mutate.js",
    "dist": "electron-builder --win portable nsis --x64",
    "icon": "node tools/make-icon.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "electron": "43.0.0",
    "electron-builder": "^26.15.3",
    "fast-check": "^3.23.2",
    "three": "0.170.0"
  },
  "build": {
    "appId": "com.alexalesha.slicercc",
    "productName": "Slicer CC",
    "copyright": "Copyright (c) 2026 ALEXalesha",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "src/**",
      "assets/icon.ico",
      "assets/icon.png",
      "LICENSE",
      "!**/*.map"
    ],
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "compression": "maximum",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "SlicerCC-${version}-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "SlicerCC-${version}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Slicer CC"
    }
  }
}
